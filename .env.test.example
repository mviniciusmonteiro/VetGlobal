# ==============================================================================
# VetGlobal — Environment Variables for Automated Tests (.env.test.example)
# ==============================================================================

APP_NAME=VetGlobal-Test
ENVIRONMENT=test
DEBUG=True

# Banco de dados dedicado exclusivamente para a execução da suíte de testes
# (Se omitido, o conftest.py deriva automaticamente do .env alterando o banco para /vetglobal_test)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vetglobal_test

# Polling rápido para acelerar a execução do pytest
POLL_TIMEOUT_SECONDS=2
POLL_INTERVAL_SECONDS=0.1

# Diretório isolado para uploads durante testes
UPLOAD_DIR=uploads_test
